generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum Role {
  superadmin
  admin
  editor
  contributor
}

enum PublishStatus {
  draft
  published
}

enum LeadStatus {
  new
  contacted
  converted
  lost
}

// ─────────────────────────── Models ───────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String
  // Legacy role column — kept (and kept in sync) because the users table is
  // shared with the Global Elite site. JMT access is decided by `adminRole`;
  // when roleId is null, access falls back to this value (app/lib/server/rbac.ts).
  role      Role     @default(contributor)
  roleId    String?
  adminRole AdminRole? @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts           Post[]
  servicePages    ServicePage[]
  packageBlocks   PackageBlock[]
  jmtServicePages JmtServicePage[]
  serviceAutosaves JmtServiceAutosave[]

  @@index([roleId])
  @@map("users")
}

// Dashboard roles (RBAC). Permission keys live in app/lib/constants/permissions.ts.
// System roles (superadmin, admin, editor, leads) are created by `npm run seed:roles`.
model AdminRole {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(60)
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(255)
  // string[] of permission keys
  permissions Json
  // System roles can't be deleted; the superadmin role can't be edited either.
  isSystem    Boolean  @default(false)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("jmt_admin_roles")
}

model Post {
  id               String        @id @default(cuid())
  title            String        @db.VarChar(500)
  slug             String        @unique
  excerpt          String?       @db.Text
  content          String?       @db.LongText
  featuredImage    String?       @db.Text
  status           PublishStatus @default(draft)
  authorId         String
  author           User          @relation(fields: [authorId], references: [id])
  categories       Category[]    @relation("PostCategories")
  // FAQ repeater: array of {question, answer}
  faqItems         Json?         @map("faq_items")
  // ACF-style fully flexible fields
  additionalFields Json?
  // JSON-LD schema objects (array)
  schemaJson       Json?         @map("schema")
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status])
  @@index([authorId])
  @@index([status, publishedAt])
  // Paginated dashboard listing sorts by newest first
  @@index([createdAt])
  @@map("posts")
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  color     String     @default("")
  parentId  String?    @map("parent_category_id")
  parent    Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryParent")
  posts     Post[]     @relation("PostCategories")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([parentId])
  // Paginated dashboard listing sorts by newest first
  @@index([createdAt])
  @@map("categories")
}

model Lead {
  id         String     @id @default(cuid())
  name       String
  email      String
  phoneNo    String
  status     LeadStatus @default(new)
  // Which website form this lead came from (e.g. "Contact — Request a Quote")
  leadSource String     @default("Website")
  // Form-specific fields as {"Field Label": value} pairs — differs per form
  // (dropdowns, subject, message…), so new forms never need schema changes.
  formData   Json?      @map("form_data")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
  // Paginated dashboard listing: newest first, optionally filtered by status
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("leads")
}

model Otp {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NOTE: MongoDB used a TTL index to auto-delete expired OTPs.
  // In MySQL, expired rows are filtered in queries and cleaned up
  // opportunistically in the request-otp route.
  @@index([email, verified])
  @@index([email, otp, verified])
  @@index([expiresAt])
  @@map("otps")
}

model MediaAsset {
  id           String   @id @default(cuid())
  key          String   @unique
  filename     String
  format       String
  resourceType String   @map("resource_type")
  bytes        Int
  url          String   @db.Text
  createdAt    DateTime @default(now())

  // Paginated media grid sorts by newest first
  @@index([createdAt])
  @@map("media_assets")
}

// Singleton page documents — content kept as JSON page-builder blobs

model ContactPage {
  id              String   @id @default(cuid())
  metaTitle       String?
  metaDescription String?  @db.Text
  content         Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("contact_pages")
}

model TermsPolicy {
  id                   String   @id @default(cuid())
  metaTitle            String?
  metaDescription      String?  @db.Text
  title                String?
  subTitle             String?
  content              Json?
  privacyPolicyContent Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("terms_policies")
}

model HeaderMenu {
  id             String   @id @default(cuid())
  mainMenu       Json     @map("main_menu")
  // Utility-bar content: {whatsappLabel, whatsappNumber, careLabel, careNumber, ctaText, ctaUrl}
  contactDetails Json?    @map("contact_details")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("header_menus")
}

model FooterMenu {
  id             String   @id @default(cuid())
  mainMenu       Json     @map("main_menu")
  contactDetails Json     @map("contact_details")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("footer_menus")
}

model ServicePage {
  id              String        @id @default(cuid())
  slug            String        @unique
  // Which frontend layout renders this page (e.g. "division" → ServiceLayout).
  // Plain string so new layouts never require a schema migration.
  template        String        @default("division")
  metaTitle       String?
  metaDescription String?       @db.Text
  // Entire page config as one flexible document (hero + ordered sections).
  // Shape: app/lib/content/service-content.ts → ServicePageContent
  content         Json
  status          PublishStatus @default(draft)
  authorId        String
  author          User          @relation(fields: [authorId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  // Paginated dashboard listing sorts by newest first
  @@index([createdAt])
  // "Recent services" widget + sitemap sort by last update
  @@index([updatedAt])
  @@map("service_pages")
}

model PackageBlock {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String        @db.VarChar(500)
  // Page slugs this block is injected into, e.g. ["travel", "education"].
  // Free-text on purpose: a block can be prepared before its page exists.
  targetPages Json          @map("target_pages")
  // Entire block as one flexible document (header + tabs + packages).
  // Shape: app/lib/content/package-content.ts → PackageBlockContent
  content     Json
  status      PublishStatus @default(draft)
  // Frontend on/off switch, independent of `status`: lets an admin pull a
  // published block off the live pages (seasonal, sold out, being rewritten)
  // without reverting it to draft or deleting it.
  visible     Boolean       @default(true)
  authorId    String
  author      User          @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  // Paginated dashboard listing sorts by newest first
  @@index([createdAt])
  @@index([updatedAt])
  @@map("package_blocks")
}

model AboutPage {
  id              String   @id @default(cuid())
  metaTitle       String?
  metaDescription String?  @db.Text
  // Entire page as one flexible document (hero, metrics, pillars,
  // accreditations, story, team, founder).
  // Shape: app/lib/content/about-content.ts → AboutPageContent
  content         Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("about_pages")
}

// Public homepage (Joy Maa Tara) served by this app at "/". Singleton.
// Owns its own navbar/footer/contact details so editing it never touches the
// HeaderMenu/FooterMenu records used by the separate main website.
model HomePage {
  id              String   @id @default(cuid())
  metaTitle       String?
  metaDescription String?  @db.Text
  // Shape: app/lib/content/home-content.ts → HomePageContent
  content         Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("home_pages")
}

// Service pages of the Joy Maa Tara site (jmt-frontend, /service/<slug>).
// Separate from ServicePage, whose "division" layout feeds the main website.
// Edited at /dashboard/services; read by the frontend through the public
// GET /api/jmt-services/client/<slug> (published pages only).
model JmtServicePage {
  id       String        @id @default(cuid())
  slug     String        @unique
  // Admin-facing name in the dashboard list (e.g. "Site labour supply").
  title    String        @db.VarChar(200)
  // Entire page as one document. Shape: types/service.ts → ServicePageContent,
  // normalized by lib/service/normalizeServicePage.ts on every save and read.
  content  Json
  status   PublishStatus @default(draft)
  authorId String
  author   User          @relation(fields: [authorId], references: [id])
  autosaves JmtServiceAutosave[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([updatedAt])
  @@map("jmt_service_pages")
}

// Unfinished edits from the service editor, one per page and user. Never read
// by the public API: only Save / Publish in the editor changes the real page.
// When a user is removed, their autosaves move to the new owner of their work.
model JmtServiceAutosave {
  id              String         @id @default(cuid())
  pageId          String
  page            JmtServicePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  title           String         @db.VarChar(200)
  slug            String         @db.VarChar(80)
  content         Json
  // Page version the edits started from, to warn if the page changed since.
  baseUpdatedAt   DateTime
  // Username of the removed author, shown to the new owner.
  transferredFrom String?        @db.VarChar(191)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([pageId, userId])
  @@index([userId])
  @@map("jmt_service_autosaves")
}

// Copy of the Joy Maa Tara site's fixed pages (jmt-frontend /about, /contact,
// /join-our-crew), one JSON document per page. Edited at
// /dashboard/site-pages/<key>; read by the frontend through the public
// GET /api/site-pages/client/<key>. The bundled copy in jmt-frontend/data is
// the schema and fallback: saved content is merged over it
// (lib/sitePages/mergeContent.ts), so new fields never need a migration.
model JmtSitePage {
  id        String   @id @default(cuid())
  // Registry key: app/lib/content/site-pages.ts (e.g. "about", "contact").
  key       String   @unique @db.VarChar(80)
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("jmt_site_pages")
}

// SEO & tracking for the Joy Maa Tara site (jmt-frontend). One row per scope:
//   "global"                              → every page (also holds the GTM ID)
//   "/", "/about", "/service/<slug>", …   → that page only
// Edited at /dashboard/seo; read by the frontend through the public
// GET /api/seo/client. Shapes and validation: app/lib/server/jmtSeo.ts.
model JmtSeo {
  id        String   @id @default(cuid())
  scope     String   @unique @db.VarChar(191)
  // Google Tag Manager container ID ("GTM-XXXXXXX"). Global row only.
  gtmId     String?  @db.VarChar(20)
  // JSON-LD objects, already parsed and validated.
  schemas   Json?
  // Custom snippets: [{ id, name, enabled, timing, code, nodes }].
  // `code` is what the admin pasted (for editing); `nodes` is its parsed,
  // allow-listed form, the only part the website renders.
  scripts   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("jmt_seo")
}
