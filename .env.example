# ── Database (MySQL via Prisma) ───────────────────────────────────────
# MySQL connection string. Prisma uses it for all data (users, pages, blogs, leads, media).
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DB_NAME?connection_limit=5"

# ── Auth ──────────────────────────────────────────────────────────────
# Secret used to sign admin login tokens (JWT). Any long random string.
# Generate one: openssl rand -hex 32
JWT_SECRET=

# ── Frontend website link ─────────────────────────────────────────────
# Public URL of the Global Elite frontend website. The API routes use it
# (CORS), and it is where cache-refresh calls are sent after content is edited.
# (The Joy Maa Tara homepage has its own setting, JMT_FRONTEND_URL, below.)
PRODUCTION_URL=https://your-jmt-website.com
# Shared secret sent with those cache-refresh calls. Must match the same
# value on the frontend project. Generate: openssl rand -hex 32
REVALIDATE_SECRET=

# ── Email (Gmail SMTP): forgot-password codes + new-lead alerts ───────
# Gmail SMTP server
SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS
SMTP_PORT=587
# false for port 587 (true only for port 465)
SMTP_SECURE=false
# Gmail address that sends the emails
SMTP_USER=
# 16-character Gmail App Password (NOT the normal password)
# Google Account → Security → 2-Step Verification → App passwords
SMTP_PASSWORD=
# Sender name + address shown in the inbox (use the same address as SMTP_USER)
SMTP_FROM="JMT CMS <same-gmail-address@gmail.com>"

# ── New-lead alerts ───────────────────────────────────────────────────
# Gets an email whenever a website form is submitted
ADMIN_NOTIFY_EMAIL=
# Optional: CC on those alerts (comma-separated for several)
# NOTIFY_CC_EMAIL=

# ── Media uploads (Hostinger FTP) ─────────────────────────────────────
# Images uploaded in the admin panel are sent here over FTP.
# FTP host / IP from Hostinger → Files → FTP Accounts (bare host, no ftp://)
HOSTINGER_FTP_HOST=
# FTP username
HOSTINGER_FTP_USER=
# FTP password
HOSTINGER_FTP_PASS=
# FTP port (normally 21)
HOSTINGER_FTP_PORT=21
# Folder on the server where files are saved
HOSTINGER_MEDIA_PATH=/public_html/media
# Public URL of that folder (used to build image links)
HOSTINGER_MEDIA_URL=https://your-domain.com/media

# ── Joy Maa Tara homepage (the separate jmt-frontend project) ─────────
# Where jmt-frontend runs. Server-side: after every content save this app
# asks it to refresh (POST /api/revalidate, using REVALIDATE_SECRET above —
# set the same secret in jmt-frontend's .env). No trailing slash.
JMT_FRONTEND_URL=http://localhost:3002
# Same URL, for the browser: the homepage editor's "View live" button and
# preview. NEXT_PUBLIC_ values are baked in at build time — rebuild after
# changing it.
NEXT_PUBLIC_JMT_FRONTEND_URL=http://localhost:3002
